---
import Layout from "../../../layouts/Layout.astro";
import { BuilderApp } from "../../../features/form/builder/BuilderApp/BuilderApp";
---

<Layout
  title="JB Form Builder"
  description="Compose and configure a portable JB form."
>
  <link rel="stylesheet" href="/styles/fonts.css" />
  <BuilderApp client:only="react">
    <div slot="fallback" class="builder-page-loading" role="status" aria-live="polite" aria-busy="true">
      <p data-en="Loading builder…" data-fa="در حال بارگذاری فرم‌ساز…">Loading builder…</p>
    </div>
  </BuilderApp>
  <script is:inline>
    try {
      const locale = localStorage.getItem("jb-form:locale");
      const loadingLabel = document.querySelector(".builder-page-loading p");
      if (loadingLabel && locale === "fa") {
        loadingLabel.textContent = loadingLabel.dataset.fa ?? loadingLabel.textContent;
        loadingLabel.lang = "fa";
        loadingLabel.dir = "rtl";
      }
    } catch {
      // Keep the default loading label when browser storage is unavailable.
    }
  </script>
</Layout>

<style>
  .builder-page-loading {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 1rem;
    min-block-size: 100dvh;
    padding: 2rem;
    box-sizing: border-box;
    color: var(--jb-content-primary);
    background: var(--jb-surface-secondary);
    text-align: center;
  }

  .builder-page-loading p {
    margin: 0;
    color: var(--jb-content-secondary);
    font: 500 1rem/1.5 "text-font", "fa-font", system-ui, sans-serif;
  }

</style>
