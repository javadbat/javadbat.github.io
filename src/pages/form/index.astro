---
import Layout from "../../layouts/Layout.astro";
import { formPageHref } from "../../features/form/application/form-page-url";
import { commonTranslations } from "../../features/form/i18n/common.translations";
import { deleteFormTranslations } from "../../features/form/landing/delete.translations";
import landingStyles from "../../features/form/landing/FormLanding.module.css";
import { formLandingAppTranslations } from "../../features/form/landing/translations";
import shellStyles from "../../features/form/shell/RouteShell.module.css";
import layoutStyles from "../../features/form/layout/FormRouteLayout.module.css";
import { FormRouteMenuIsland } from "../../features/form/layout/FormRouteMenuIsland";

const builderHref = formPageHref("builder");
const previewHref = formPageHref("preview");
const designerHref = formPageHref("designer");
const components = [
  ["Text", "متن", "content-text"], ["Image", "تصویر", "content-image"], ["Voice", "صوت", "content-voice"], ["Link", "پیوند", "content-link"],
  ["Divider / spacer", "جداکننده / فاصله", "drag"], ["Section heading", "عنوان بخش", "content-text"],
  ["Text input", "ورودی متن", "text-input"], ["Number input", "ورودی عدد", "number-input"], ["Range input", "ورودی بازه", "number-input"],
  ["Mobile input", "شماره موبایل", "mobile-input"], ["Password input", "گذرواژه", "password-input"], ["Payment input", "اطلاعات پرداخت", "payment-input"],
  ["National ID", "کد ملی", "national-input"], ["Date input", "تاریخ", "date-input"], ["Time input", "زمان", "time-input"], ["PIN input", "کد تأیید", "pin-input"],
  ["Textarea", "متن چندخطی", "textarea"], ["Select", "فهرست انتخاب", "select"], ["Listbox", "فهرست باز", "select"],
  ["Checkbox", "کادر انتخاب", "checkbox"], ["Switch", "کلید روشن/خاموش", "switch"], ["File input", "بارگذاری فایل", "file-input"],
  ["Image input", "بارگذاری تصویر", "image-input"], ["Button", "دکمه", "button"], ["Tabs", "زبانه‌ها", "select"],
  ["Conditional container", "بخش شرطی", "switch"], ["Wizard", "فرم مرحله‌ای", "move-down"], ["Repeatable group", "گروه تکرارشونده", "duplicate"],
].map(([en, fa, icon]) => ({ en, fa, icon }));
const sectionDecor = {
  hero: ["content-link", "checkbox", "date-input"],
  features: ["drag", "settings", "switch"],
  workflow: ["content-text", "configure", "content-image"],
  embed: ["content-text", "duplicate", "button"],
  global: ["language", "mobile-input", "content-voice"],
  designer: ["settings", "content-image", "configure"],
  workspace: ["file-input", "textarea", "select"],
  final: ["button", "content-link", "checkbox"],
};
---

<Layout title="JB Form — Open-source visual form builder" description="Build forms visually, export portable JSON, and render them anywhere with the open-source jb-form-builder component.">
  <div class={`${shellStyles.page} ${landingStyles.page}`} data-form-landing>
    <header class={`${layoutStyles.header} ${landingStyles.topbar}`}>
      <a class={`${shellStyles.brand} ${landingStyles.brand}`} href="/form"><span class={`${layoutStyles.brandMark} ${shellStyles.brandMark}`}>JB</span><span><strong data-i18n="common:productName">{commonTranslations.en.productName}</strong><small data-i18n="formLandingApp:openSourceLabel">{formLandingAppTranslations.en.openSourceLabel}</small></span></a>
      <nav class={landingStyles.nav} aria-label="Primary navigation"><a href="#features" data-i18n="formLandingApp:navFeatures">{formLandingAppTranslations.en.navFeatures}</a><a href="#components" data-i18n="formLandingApp:navComponents">{formLandingAppTranslations.en.navComponents}</a><a href="#embed" data-i18n="formLandingApp:navEmbed">{formLandingAppTranslations.en.navEmbed}</a><a href="#workspace" data-i18n="formLandingApp:navWorkspace">{formLandingAppTranslations.en.navWorkspace}</a></nav>
      <div class={landingStyles.topActions}><a class={landingStyles.sourceLink} href="https://github.com/javadbat/javadbat.github.io" target="_blank" rel="noreferrer" data-i18n="formLandingApp:viewSource">{formLandingAppTranslations.en.viewSource}</a><FormRouteMenuIsland client:load /><a class={`${landingStyles.button} ${landingStyles.buttonPrimary} ${landingStyles.buttonSmall}`} href={builderHref} data-draft-action>{formLandingAppTranslations.en.createForm}</a></div>
    </header>

    <main>
      <section class={`${landingStyles.section} ${landingStyles.hero}`}>
        <div class={landingStyles.heroCopy}>
          <div class={`${landingStyles.sectionDecor} ${landingStyles.decorHero}`} aria-hidden="true">{sectionDecor.hero.map((icon) => <span><svg><use href={`/form/catalog-icons.svg#${icon}`} /></svg></span>)}</div>
          <div class={landingStyles.openBadge}><span></span><b data-i18n="formLandingApp:openSourceBadge">{formLandingAppTranslations.en.openSourceBadge}</b></div>
          <p class={landingStyles.eyebrow} data-i18n="formLandingApp:workspaceEyebrow">{formLandingAppTranslations.en.workspaceEyebrow}</p>
          <h1 data-i18n="formLandingApp:formHomeTitle">{formLandingAppTranslations.en.formHomeTitle}</h1>
          <p class={landingStyles.heroDescription} data-i18n="formLandingApp:formHomeDescription">{formLandingAppTranslations.en.formHomeDescription}</p>
          <div class={landingStyles.heroActions}><a class={`${landingStyles.button} ${landingStyles.buttonPrimary} ${landingStyles.buttonLarge}`} href={builderHref} data-draft-action>{formLandingAppTranslations.en.createForm}</a><a class={`${landingStyles.button} ${landingStyles.buttonSecondary} ${landingStyles.buttonLarge}`} href={previewHref} data-preview-draft><jb-icon-eye size="sm" open></jb-icon-eye><span data-i18n="formLandingApp:seeLivePreview">{formLandingAppTranslations.en.seeLivePreview}</span></a></div>
          <p class={landingStyles.heroNote} data-i18n="formLandingApp:heroNote">{formLandingAppTranslations.en.heroNote}</p>
        </div>

        <div class={landingStyles.heroProduct} aria-label="JB Form builder interface">
          <div class={landingStyles.productWindow}>
            <div class={landingStyles.productToolbar}><div><span>JB</span><strong data-en="Untitled form" data-fa="فرم بدون عنوان">Untitled form</strong><i data-en="Saved" data-fa="ذخیره شده">Saved</i></div><div><span data-en="Import JSON" data-fa="ورود JSON">Import JSON</span><span data-en="Export JSON" data-fa="خروجی JSON">Export JSON</span><b data-en="Save" data-fa="ذخیره">Save</b></div></div>
            <div class={landingStyles.builderGrid}>
              <aside class={landingStyles.catalogPanel}><header><div><small data-en="BUILDER" data-fa="فرم‌ساز">BUILDER</small><strong data-en="Components" data-fa="اجزا">Components</strong></div><b data-en="28" data-fa="۲۸">28</b></header><div class={landingStyles.searchMock} data-en="Search components" data-fa="جست‌وجوی اجزا">Search components</div>{components.slice(0, 7).map((item) => <div class={landingStyles.catalogItem}><svg class={landingStyles.catalogElementIcon} aria-hidden="true" focusable="false"><use href={`/form/catalog-icons.svg#${item.icon}`} /></svg><span data-en={item.en} data-fa={item.fa}>{item.en}</span><b data-en="Add" data-fa="افزودن">Add</b></div>)}</aside>
              <div class={landingStyles.canvasPanel}><small data-en="CURRENT DRAFT" data-fa="پیش‌نویس فعلی">CURRENT DRAFT</small><h2 data-en="Untitled form" data-fa="فرم بدون عنوان">Untitled form</h2><div class={landingStyles.canvasCard}><span>⋮⋮</span><div><strong data-en="Full name" data-fa="نام و نام خانوادگی">Full name</strong><small data-en="Text input" data-fa="ورودی متن">Text input</small></div></div><div class={landingStyles.canvasCard}><span>⋮⋮</span><div><strong data-en="Country" data-fa="کشور">Country</strong><small data-en="Select" data-fa="فهرست انتخاب">Select</small></div></div><div class={`${landingStyles.canvasCard} ${landingStyles.canvasCardActive}`}><span>⋮⋮</span><div><strong data-en="Email address" data-fa="نشانی ایمیل">Email address</strong><small data-en="Text input · required" data-fa="ورودی متن · الزامی">Text input · required</small></div></div><div class={landingStyles.dropZone} data-en="Drop a component here" data-fa="جزء را اینجا رها کنید">Drop a component here</div></div>
              <aside class={landingStyles.propertiesPanel}><small data-en="SETTINGS" data-fa="تنظیمات">SETTINGS</small><h3 data-en="Properties" data-fa="ویژگی‌ها">Properties</h3><label><span data-en="Label" data-fa="عنوان">Label</span><input value="Email address" data-value-en="Email address" data-value-fa="نشانی ایمیل" readonly /></label><label><span data-en="Placeholder" data-fa="متن راهنما">Placeholder</span><input value="you@example.com" readonly /></label><label><span data-en="Validation" data-fa="اعتبارسنجی">Validation</span><select><option data-en="Email" data-fa="ایمیل">Email</option></select></label><div class={landingStyles.toggleRow}><span data-en="Required" data-fa="الزامی">Required</span><i></i></div></aside>
            </div>
          </div>
          <div class={`${landingStyles.floatCard} ${landingStyles.jsonCard}`}><span>form.json</span><code>{'{ "type": "jb-input",\n  "name": "email",\n  "required": true }'}</code></div>
          <div class={`${landingStyles.floatCard} ${landingStyles.errorCard}`}><strong data-i18n="formLandingApp:validationError">{formLandingAppTranslations.en.validationError}</strong><span data-i18n="formLandingApp:validationHint">{formLandingAppTranslations.en.validationHint}</span></div>
          <div class={`${landingStyles.floatCard} ${landingStyles.rtlCard}`} dir="rtl"><strong>فرم ثبت‌نام</strong><label>نام<input value="علی" readonly /></label><button type="button">ارسال</button></div>
        </div>
      </section>

      <section class={`${landingStyles.section} ${landingStyles.valueStrip}`}>
        <article><jb-icon-edit size="sm"></jb-icon-edit><div><strong data-i18n="formLandingApp:valueVisual">{formLandingAppTranslations.en.valueVisual}</strong><span data-i18n="formLandingApp:valueVisualDescription">{formLandingAppTranslations.en.valueVisualDescription}</span></div></article>
        <article><jb-icon-expand size="sm"></jb-icon-expand><div><strong data-i18n="formLandingApp:valuePortable">{formLandingAppTranslations.en.valuePortable}</strong><span data-i18n="formLandingApp:valuePortableDescription">{formLandingAppTranslations.en.valuePortableDescription}</span></div></article>
        <article><jb-icon-eye size="sm" open></jb-icon-eye><div><strong data-i18n="formLandingApp:valueAccessible">{formLandingAppTranslations.en.valueAccessible}</strong><span data-i18n="formLandingApp:valueAccessibleDescription">{formLandingAppTranslations.en.valueAccessibleDescription}</span></div></article>
        <article><jb-icon-arrow-tailed size="sm"></jb-icon-arrow-tailed><div><strong data-i18n="formLandingApp:valueAnywhere">{formLandingAppTranslations.en.valueAnywhere}</strong><span data-i18n="formLandingApp:valueAnywhereDescription">{formLandingAppTranslations.en.valueAnywhereDescription}</span></div></article>
      </section>

      <section id="components" class={`${landingStyles.section} ${landingStyles.componentSection}`}>
        <div class={`${landingStyles.sectionDecor} ${landingStyles.decorComponents}`} aria-hidden="true"><span><svg><use href="/form/catalog-icons.svg#content-image" /></svg></span><span><svg><use href="/form/catalog-icons.svg#date-input" /></svg></span><span><svg><use href="/form/catalog-icons.svg#switch" /></svg></span><span><svg><use href="/form/catalog-icons.svg#content-voice" /></svg></span></div>
        <div class={landingStyles.sectionHeading}><div><p class={landingStyles.eyebrow} data-i18n="formLandingApp:componentEyebrow">{formLandingAppTranslations.en.componentEyebrow}</p><h2 data-i18n="formLandingApp:componentTitle">{formLandingAppTranslations.en.componentTitle}</h2></div><p data-i18n="formLandingApp:componentDescription">{formLandingAppTranslations.en.componentDescription}</p></div>
        <div class={landingStyles.componentGrid}>{components.map((item) => <div class={landingStyles.componentChip}><i class={landingStyles.componentIconTile}><svg class={landingStyles.componentIcon} aria-hidden="true" focusable="false"><use href={`/form/catalog-icons.svg#${item.icon}`} /></svg></i><span data-en={item.en} data-fa={item.fa}>{item.en}</span></div>)}</div>
      </section>

      <section id="features" class={`${landingStyles.section} ${landingStyles.features}`}>
        <div class={`${landingStyles.sectionDecor} ${landingStyles.decorFeatures}`} aria-hidden="true">{sectionDecor.features.map((icon) => <span><svg><use href={`/form/catalog-icons.svg#${icon}`} /></svg></span>)}</div>
        <div class={`${landingStyles.sectionHeading} ${landingStyles.headingCentered}`}><div><p class={landingStyles.eyebrow} data-i18n="formLandingApp:featuresEyebrow">{formLandingAppTranslations.en.featuresEyebrow}</p><h2 data-i18n="formLandingApp:featuresTitle">{formLandingAppTranslations.en.featuresTitle}</h2></div><p data-i18n="formLandingApp:featuresDescription">{formLandingAppTranslations.en.featuresDescription}</p></div>
        <div class={landingStyles.featureGrid}>
          <article><span class={landingStyles.step} data-en="1" data-fa="۱">1</span><h3 data-i18n="formLandingApp:featureBuildTitle">{formLandingAppTranslations.en.featureBuildTitle}</h3><p data-i18n="formLandingApp:featureBuildDescription">{formLandingAppTranslations.en.featureBuildDescription}</p><div class={landingStyles.reorderVisual}><span data-en="Full name" data-fa="نام و نام خانوادگی">Full name</span><span data-en="Email address" data-fa="نشانی ایمیل">Email address</span><i data-en="Drop here" data-fa="اینجا رها کنید">Drop here</i></div></article>
          <article><span class={`${landingStyles.step} ${landingStyles.stepCoral}`} data-en="2" data-fa="۲">2</span><h3 data-i18n="formLandingApp:featureConfigureTitle">{formLandingAppTranslations.en.featureConfigureTitle}</h3><p data-i18n="formLandingApp:featureConfigureDescription">{formLandingAppTranslations.en.featureConfigureDescription}</p><div class={landingStyles.configureVisual}><label><span data-en="Label" data-fa="عنوان">Label</span><input value="Email address" data-value-en="Email address" data-value-fa="نشانی ایمیل" readonly /></label><label><span data-en="Validation" data-fa="اعتبارسنجی">Validation</span><select><option data-en="Email" data-fa="ایمیل">Email</option></select></label><strong data-i18n="formLandingApp:validEmailPrompt">{formLandingAppTranslations.en.validEmailPrompt}</strong></div></article>
          <article><span class={`${landingStyles.step} ${landingStyles.stepMint}`} data-en="3" data-fa="۳">3</span><h3 data-i18n="formLandingApp:featureLogicTitle">{formLandingAppTranslations.en.featureLogicTitle}</h3><p data-i18n="formLandingApp:featureLogicDescription">{formLandingAppTranslations.en.featureLogicDescription}</p><div class={landingStyles.logicVisual}><strong data-en="Show National ID if" data-fa="نمایش کد ملی اگر">Show National ID if</strong><p><span data-en="Country" data-fa="کشور">Country</span><span data-en="is" data-fa="برابر است با">is</span><span data-en="Iran" data-fa="ایران">Iran</span></p><label><span data-en="National ID" data-fa="کد ملی">National ID</span><input value="1234567890" data-value-en="1234567890" data-value-fa="۱۲۳۴۵۶۷۸۹۰" readonly /></label></div></article>
          <article><span class={`${landingStyles.step} ${landingStyles.stepCoral}`} data-en="4" data-fa="۴">4</span><h3 data-i18n="formLandingApp:featureStructureTitle">{formLandingAppTranslations.en.featureStructureTitle}</h3><p data-i18n="formLandingApp:featureStructureDescription">{formLandingAppTranslations.en.featureStructureDescription}</p><div class={landingStyles.structureVisual}><span class={landingStyles.active} data-en="1 · Account" data-fa="۱ · حساب">1 · Account</span><span data-en="2 · Profile" data-fa="۲ · پروفایل">2 · Profile</span><span data-en="3 · Review" data-fa="۳ · بازبینی">3 · Review</span></div></article>
        </div>
      </section>

      <section class={`${landingStyles.section} ${landingStyles.workflow}`}>
        <div class={`${landingStyles.sectionDecor} ${landingStyles.decorWorkflow}`} aria-hidden="true">{sectionDecor.workflow.map((icon) => <span><svg><use href={`/form/catalog-icons.svg#${icon}`} /></svg></span>)}</div>
        <div class={`${landingStyles.sectionHeading} ${landingStyles.headingCentered}`}><div><p class={landingStyles.eyebrow} data-i18n="formLandingApp:workflowEyebrow">{formLandingAppTranslations.en.workflowEyebrow}</p><h2 data-i18n="formLandingApp:workflowTitle">{formLandingAppTranslations.en.workflowTitle}</h2></div><p data-i18n="formLandingApp:workflowDescription">{formLandingAppTranslations.en.workflowDescription}</p></div>
        <ol><li><span>1</span><strong data-i18n="formLandingApp:workflowBuild">{formLandingAppTranslations.en.workflowBuild}</strong><p data-i18n="formLandingApp:workflowBuildDescription">{formLandingAppTranslations.en.workflowBuildDescription}</p></li><li><span>2</span><strong data-i18n="formLandingApp:workflowConfigure">{formLandingAppTranslations.en.workflowConfigure}</strong><p data-i18n="formLandingApp:workflowConfigureDescription">{formLandingAppTranslations.en.workflowConfigureDescription}</p></li><li><span>3</span><strong data-i18n="formLandingApp:workflowPreview">{formLandingAppTranslations.en.workflowPreview}</strong><p data-i18n="formLandingApp:workflowPreviewDescription">{formLandingAppTranslations.en.workflowPreviewDescription}</p></li><li><span>4</span><strong data-i18n="formLandingApp:workflowExport">{formLandingAppTranslations.en.workflowExport}</strong><p data-i18n="formLandingApp:workflowExportDescription">{formLandingAppTranslations.en.workflowExportDescription}</p></li></ol>
      </section>

      <section id="embed" class={`${landingStyles.section} ${landingStyles.embedSection}`}>
        <div class={`${landingStyles.sectionDecor} ${landingStyles.decorEmbed}`} aria-hidden="true">{sectionDecor.embed.map((icon) => <span><svg><use href={`/form/catalog-icons.svg#${icon}`} /></svg></span>)}</div>
        <div class={landingStyles.embedCopy}><span class={landingStyles.mitBadge} data-en="MIT · OPEN SOURCE" data-fa="متن‌باز · مجوز MIT">MIT · OPEN SOURCE</span><h2 data-i18n="formLandingApp:embedTitle">{formLandingAppTranslations.en.embedTitle}</h2><p data-i18n="formLandingApp:embedDescription">{formLandingAppTranslations.en.embedDescription}</p><ul><li data-i18n="formLandingApp:embedPoint1">{formLandingAppTranslations.en.embedPoint1}</li><li data-i18n="formLandingApp:embedPoint2">{formLandingAppTranslations.en.embedPoint2}</li><li data-i18n="formLandingApp:embedPoint3">{formLandingAppTranslations.en.embedPoint3}</li></ul><div><a class={`${landingStyles.button} ${landingStyles.buttonLight}`} href={builderHref} data-i18n="formLandingApp:buildAForm">{formLandingAppTranslations.en.buildAForm}</a><a class={`${landingStyles.button} ${landingStyles.buttonDarkQuiet}`} href="https://github.com/javadbat/javadbat.github.io" target="_blank" rel="noreferrer" data-i18n="formLandingApp:browseSource">{formLandingAppTranslations.en.browseSource}</a></div></div>
        <div class={landingStyles.codeWindow}><div class={landingStyles.codeTabs} role="tablist"><button type="button" aria-selected="true" data-code-tab="web" data-en="Web component" data-fa="وب‌کامپوننت">Web component</button><button type="button" aria-selected="false" data-code-tab="react">React</button><button type="button" data-copy-code data-en="Copy" data-fa="کپی">Copy</button></div>
          <pre data-code-panel="web"><code>import "jb-form-builder";
import &#123; loadDependencies &#125; from
  "jb-form-builder/dependency-loader";

const form = document.querySelector(
  "jb-form-builder"
);
form.loadDependencies = loadDependencies;
form.formDocument = exportedJson;</code></pre>
          <pre data-code-panel="react" hidden><code>import &#123; JBFormBuilder &#125; from
  "jb-form-builder/react";

&lt;JBFormBuilder
  formDocument=&#123;exportedJson&#125;
  loadDependencies=&#123;loadDependencies&#125;
/&gt;</code></pre>
          <div class={landingStyles.renderResult}><span>&lt;jb-form-builder&gt;</span><strong data-i18n="formLandingApp:renderedOnYourSite">{formLandingAppTranslations.en.renderedOnYourSite}</strong><i data-en="Framework-independent · route-agnostic" data-fa="مستقل از فریم‌ورک · مستقل از مسیر">Framework-independent · route-agnostic</i></div>
        </div>
      </section>

      <section class={`${landingStyles.section} ${landingStyles.globalSection}`}>
        <div class={`${landingStyles.sectionDecor} ${landingStyles.decorGlobal}`} aria-hidden="true">{sectionDecor.global.map((icon) => <span><svg><use href={`/form/catalog-icons.svg#${icon}`} /></svg></span>)}</div>
        <div class={landingStyles.sectionHeading}><div><p class={landingStyles.eyebrow} data-i18n="formLandingApp:globalEyebrow">{formLandingAppTranslations.en.globalEyebrow}</p><h2 data-i18n="formLandingApp:globalTitle">{formLandingAppTranslations.en.globalTitle}</h2></div><p data-i18n="formLandingApp:globalDescription">{formLandingAppTranslations.en.globalDescription}</p></div>
        <div class={landingStyles.globalGrid}><article class={landingStyles.localeCard} dir="ltr"><header><strong>English</strong><span>LTR</span></header><label>Full name<input value="Ali Rezaei" readonly /></label><label>Email<input value="ali@example.com" readonly /></label><label>Message<textarea readonly>Tell us about your project.</textarea></label><button type="button">Send</button></article><article class={landingStyles.localeCard} dir="rtl"><header><strong>فارسی</strong><span>RTL</span></header><label>نام و نام خانوادگی<input value="علی رضایی" readonly /></label><label>ایمیل<input value="ali@example.com" readonly /></label><label>پیام<textarea readonly>درباره پروژه خود بنویسید.</textarea></label><button type="button">ارسال</button></article><article class={landingStyles.localeCard}><header><strong data-i18n="formLandingApp:livePreviewTitle">{formLandingAppTranslations.en.livePreviewTitle}</strong><span data-en="Responsive" data-fa="واکنش‌گرا">Responsive</span></header><label><span data-en="Satisfaction" data-fa="میزان رضایت">Satisfaction</span><input type="range" min="0" max="10" value="8" /></label><label><span data-en="Country" data-fa="کشور">Country</span><select><option data-en="United States" data-fa="ایالات متحده">United States</option></select></label><label><span data-en="Comments" data-fa="توضیحات">Comments</span><textarea readonly data-value-en="Great experience!" data-value-fa="تجربه بسیار خوبی بود!">Great experience!</textarea></label><button type="button" data-en="Submit" data-fa="ثبت">Submit</button></article></div>
      </section>

      <section class={`${landingStyles.section} ${landingStyles.designerSection}`}>
        <div class={`${landingStyles.sectionDecor} ${landingStyles.decorDesigner}`} aria-hidden="true">{sectionDecor.designer.map((icon) => <span><svg><use href={`/form/catalog-icons.svg#${icon}`} /></svg></span>)}</div>
        <div><span class={landingStyles.constructionBadge} data-i18n="formLandingApp:underConstruction">{formLandingAppTranslations.en.underConstruction}</span><p class={landingStyles.eyebrow} data-i18n="formLandingApp:designerEyebrow">{formLandingAppTranslations.en.designerEyebrow}</p><h2 data-i18n="formLandingApp:designerTitle">{formLandingAppTranslations.en.designerTitle}</h2><p data-i18n="formLandingApp:designerDescription">{formLandingAppTranslations.en.designerDescription}</p><a class={`${landingStyles.button} ${landingStyles.buttonSecondary}`} href={designerHref} data-i18n="formLandingApp:visitDesignerRoute">{formLandingAppTranslations.en.visitDesignerRoute}</a></div>
        <div class={landingStyles.designerPreview}><aside><strong data-en="Theme" data-fa="پوسته">Theme</strong><span data-en="Colors" data-fa="رنگ‌ها">Colors</span><span data-en="Typography" data-fa="تایپوگرافی">Typography</span><span data-en="Spacing" data-fa="فاصله‌گذاری">Spacing</span><span data-en="Components" data-fa="اجزا">Components</span></aside><div><strong data-en="Theme Designer" data-fa="طراح پوسته">Theme Designer</strong><span data-i18n="formLandingApp:inProgress">{formLandingAppTranslations.en.inProgress}</span></div></div>
      </section>

      <section id="workspace" class={`${landingStyles.section} ${landingStyles.workspaceSection}`}>
        <div class={`${landingStyles.sectionDecor} ${landingStyles.decorWorkspace}`} aria-hidden="true">{sectionDecor.workspace.map((icon) => <span><svg><use href={`/form/catalog-icons.svg#${icon}`} /></svg></span>)}</div>
        <div class={landingStyles.workspaceIntro}><p class={landingStyles.eyebrow} data-i18n="formLandingApp:workspaceLabel">{formLandingAppTranslations.en.workspaceLabel}</p><h2 data-i18n="formLandingApp:workspaceTitle">{formLandingAppTranslations.en.workspaceTitle}</h2><p data-i18n="formLandingApp:formsLibraryDescription">{formLandingAppTranslations.en.formsLibraryDescription}</p><a class={`${landingStyles.button} ${landingStyles.buttonPrimary}`} href={builderHref} data-draft-action>{formLandingAppTranslations.en.createForm}</a></div>
        <div class={landingStyles.library}>
          <div class={landingStyles.libraryHeader}><div class={landingStyles.headingLine}><h3 data-i18n="formLandingApp:savedForms">{formLandingAppTranslations.en.savedForms}</h3><span class={landingStyles.count} data-form-count>0</span></div><label class={landingStyles.search} data-search-control hidden><span class={landingStyles.visuallyHidden} data-i18n="formLandingApp:searchForms">{formLandingAppTranslations.en.searchForms}</span><input type="search" data-form-search data-i18n-placeholder="formLandingApp:searchFormsPlaceholder" placeholder={formLandingAppTranslations.en.searchFormsPlaceholder} /></label></div>
          <section class={landingStyles.draftPanel} data-current-draft hidden><div><p class={landingStyles.eyebrow} data-i18n="common:currentDraft">{commonTranslations.en.currentDraft}</p><h3 data-draft-name></h3><p class={landingStyles.draftMeta}><span data-draft-fields></span><span>·</span><span data-i18n="formLandingApp:updated">{formLandingAppTranslations.en.updated}</span><time data-draft-updated></time></p></div><div class={landingStyles.draftActions}><a class={`${landingStyles.button} ${landingStyles.buttonOnAccent}`} href={builderHref} data-i18n="formLandingApp:continueDraft">{formLandingAppTranslations.en.continueDraft}</a><a class={`${landingStyles.button} ${landingStyles.buttonOnAccentQuiet}`} href={previewHref} data-draft-preview-link data-i18n="common:preview">{commonTranslations.en.preview}</a></div></section>
          <output class={landingStyles.state} data-forms-loading data-i18n="common:loadingForms">{commonTranslations.en.loadingForms}</output>
          <div class={`${landingStyles.state} ${landingStyles.errorState}`} role="alert" data-forms-error hidden><strong data-i18n="formLandingApp:storageUnavailableTitle">{formLandingAppTranslations.en.storageUnavailableTitle}</strong><p data-i18n="common:storageUnavailable">{commonTranslations.en.storageUnavailable}</p></div>
          <div class={`${landingStyles.state} ${landingStyles.emptyState}`} data-forms-empty hidden><strong data-i18n="formLandingApp:emptyFormsTitle">{formLandingAppTranslations.en.emptyFormsTitle}</strong><p data-i18n="formLandingApp:emptyFormsDescription">{formLandingAppTranslations.en.emptyFormsDescription}</p><a class={`${landingStyles.button} ${landingStyles.buttonPrimary}`} href={builderHref} data-draft-action>{formLandingAppTranslations.en.createForm}</a></div>
          <p class={landingStyles.state} data-forms-no-results data-i18n="formLandingApp:noMatchingForms" hidden>{formLandingAppTranslations.en.noMatchingForms}</p><ul class={landingStyles.formGrid} data-form-list hidden></ul>
        </div>
      </section>

      <section class={`${landingStyles.section} ${landingStyles.finalCta}`}><div class={`${landingStyles.sectionDecor} ${landingStyles.decorFinal}`} aria-hidden="true">{sectionDecor.final.map((icon) => <span><svg><use href={`/form/catalog-icons.svg#${icon}`} /></svg></span>)}</div><div><p class={landingStyles.eyebrow} data-i18n="formLandingApp:finalEyebrow">{formLandingAppTranslations.en.finalEyebrow}</p><h2 data-i18n="formLandingApp:finalTitle">{formLandingAppTranslations.en.finalTitle}</h2><p data-i18n="formLandingApp:finalDescription">{formLandingAppTranslations.en.finalDescription}</p></div><div><a class={`${landingStyles.button} ${landingStyles.buttonPrimary} ${landingStyles.buttonLarge}`} href={builderHref} data-i18n="formLandingApp:startBuilding">{formLandingAppTranslations.en.startBuilding}</a><a class={`${landingStyles.button} ${landingStyles.buttonSecondary} ${landingStyles.buttonLarge}`} href="#embed" data-i18n="formLandingApp:seeEmbedCode">{formLandingAppTranslations.en.seeEmbedCode}</a></div></section>
    </main>

    <footer class={landingStyles.footer}><a class={shellStyles.brand} href="/form"><span class={shellStyles.brandMark}>JB</span><span><strong>JB Form</strong><small data-i18n="formLandingApp:footerTagline">{formLandingAppTranslations.en.footerTagline}</small></span></a><div><strong data-en="Product" data-fa="محصول">Product</strong><a href="#features" data-en="Features" data-fa="قابلیت‌ها">Features</a><a href="#components" data-en="Components" data-fa="اجزا">Components</a><a href="#embed" data-en="Embed" data-fa="نحوه استفاده">Embed</a></div><div><strong data-en="Build" data-fa="ساخت">Build</strong><a href={builderHref} data-en="Builder" data-fa="فرم‌ساز">Builder</a><a href={previewHref} data-en="Preview" data-fa="پیش‌نمایش">Preview</a><a href={designerHref} data-i18n="formLandingApp:designerComingSoon">{formLandingAppTranslations.en.designerComingSoon}</a></div><div><strong data-en="Open source" data-fa="متن‌باز">Open source</strong><a href="https://github.com/javadbat/javadbat.github.io" target="_blank" rel="noreferrer">GitHub</a><span data-en="MIT License" data-fa="مجوز MIT">MIT License</span><span>jb-form-builder</span></div><small>© 2026 JB Form.</small></footer>
    <template data-form-card-template><li class={landingStyles.formCard}><div class={landingStyles.cardHeader}><div><strong data-form-name></strong><code data-form-slug></code></div><span class={landingStyles.fieldBadge} data-field-count></span></div><p class={landingStyles.updatedLine}><span data-i18n="formLandingApp:updated">{formLandingAppTranslations.en.updated}</span><time data-form-updated></time></p><div class={landingStyles.cardActions}><a class={`${landingStyles.button} ${landingStyles.buttonPrimary} ${landingStyles.buttonSmall}`} data-load-form data-i18n="formLandingApp:loadForm">{formLandingAppTranslations.en.loadForm}</a><a class={`${landingStyles.button} ${landingStyles.buttonSecondary} ${landingStyles.buttonSmall}`} data-preview-form data-i18n="common:preview">{commonTranslations.en.preview}</a><button class={`${landingStyles.button} ${landingStyles.buttonDanger} ${landingStyles.buttonSmall}`} type="button" data-delete-form data-i18n="deleteForm:deleteForm">{deleteFormTranslations.en.deleteForm}</button></div></li></template>
  </div>
</Layout>

<script>
  import { registerDefaultVariables } from "jb-core/theme";
  import { formI18n } from "../../features/form/i18n/i18n";
  import "jb-icons/arrow-tailed";
  import "jb-icons/edit";
  import "jb-icons/expand";
  import "jb-icons/eye";
  import "jb-icons/plus";
  import { formPageHref } from "../../features/form/application/form-page-url";
  registerDefaultVariables();
  import { getLocalizedText } from "../../features/form/domain/form-document";
  import { formRepository } from "../../features/form/storage/form-repository";
  import type { CurrentDraftRecordV1, StoredFormRecordV1 } from "../../features/form/storage/storage-types";

  const t = formI18n.getFixedT(null, "formLandingApp");
  const tCommon = formI18n.getFixedT(null, "common");
  const tDelete = formI18n.getFixedT(null, "deleteForm");
  const landing = document.querySelector<HTMLElement>("[data-form-landing]");
  const template = landing?.querySelector<HTMLTemplateElement>("[data-form-card-template]");
  const list = landing?.querySelector<HTMLUListElement>("[data-form-list]");
  const searchInput = landing?.querySelector<HTMLInputElement>("[data-form-search]");
  let forms: StoredFormRecordV1[] = [];
  let draft: CurrentDraftRecordV1 | null = null;
  let query = "";

  function setHidden(selector: string, hidden: boolean) {
    const element = landing?.querySelector<HTMLElement>(selector);
    if (element) element.hidden = hidden;
  }
  function localizedName(record: StoredFormRecordV1 | CurrentDraftRecordV1) {
    return getLocalizedText(record.document.metadata.name, formI18n.language, record.document.localization.defaultLocale);
  }
  function formatFieldCount(count: number) {
    return `${count} ${count === 1 ? tCommon("field") : tCommon("fields")}`;
  }
  function applyLocale() {
    if (!landing) return;
    const direction = formI18n.language === "fa" ? "rtl" : "ltr";
    landing.dir = direction;
    landing.querySelectorAll<HTMLElement>("[data-i18n]").forEach(element => {
      element.textContent = formI18n.t(element.dataset.i18n!, { defaultValue: "" });
    });
    landing.querySelectorAll<HTMLInputElement>("[data-i18n-placeholder]").forEach(element => {
      element.placeholder = formI18n.t(element.dataset.i18nPlaceholder!, { defaultValue: "" });
    });
    landing.querySelectorAll<HTMLElement>("[data-en][data-fa]").forEach(element => {
      element.textContent = formI18n.language === "fa" ? element.dataset.fa! : element.dataset.en!;
    });
    landing.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[data-value-en][data-value-fa]").forEach(element => {
      element.value = formI18n.language === "fa" ? element.dataset.valueFa! : element.dataset.valueEn!;
    });
    landing.querySelectorAll<HTMLElement>("[data-draft-action]").forEach(element => {
      element.textContent = draft ? t("continueDraft") : t("createForm");
    });
    const count = landing.querySelector<HTMLElement>("[data-form-count]")!;
    count.setAttribute("aria-label", `${forms.length} ${forms.length === 1 ? t("savedForm") : t("savedForms")}`);
  }
  function renderDraft() {
    if (!landing) return;
    setHidden("[data-current-draft]", !draft);
    setHidden("[data-preview-draft]", !draft);
    if (!draft) return;
    const formatter = new Intl.DateTimeFormat(formI18n.language, { dateStyle: "medium", timeStyle: "short" });
    landing.querySelector<HTMLElement>("[data-draft-name]")!.textContent = localizedName(draft);
    landing.querySelector<HTMLElement>("[data-draft-fields]")!.textContent = formatFieldCount(draft.document.elements.length);
    const updated = landing.querySelector<HTMLTimeElement>("[data-draft-updated]")!;
    updated.dateTime = draft.updatedAt;
    updated.textContent = formatter.format(new Date(draft.updatedAt));
    landing.querySelector<HTMLAnchorElement>("[data-draft-preview-link]")!.href = formPageHref("preview", draft.linkedSlug ?? undefined);
  }
  function renderForms() {
    if (!landing || !template || !list) return;
    const formatter = new Intl.DateTimeFormat(formI18n.language, { dateStyle: "medium", timeStyle: "short" });
    const normalizedQuery = query.trim().toLocaleLowerCase(formI18n.language);
    const visibleForms = forms.filter(record => `${localizedName(record)} ${record.slug}`.toLocaleLowerCase(formI18n.language).includes(normalizedQuery));
    list.replaceChildren();
    landing.querySelector<HTMLElement>("[data-form-count]")!.textContent = String(forms.length);
    for (const record of visibleForms) {
      const fragment = template.content.cloneNode(true) as DocumentFragment;
      const card = fragment.querySelector<HTMLElement>("li")!;
      card.querySelector<HTMLElement>("[data-form-name]")!.textContent = localizedName(record);
      card.querySelector<HTMLElement>("[data-form-slug]")!.textContent = record.slug;
      card.querySelector<HTMLElement>("[data-field-count]")!.textContent = formatFieldCount(record.document.elements.length);
      const updated = card.querySelector<HTMLTimeElement>("[data-form-updated]")!;
      updated.dateTime = record.updatedAt;
      updated.textContent = formatter.format(new Date(record.updatedAt));
      card.querySelector<HTMLAnchorElement>("[data-load-form]")!.href = formPageHref("builder", record.slug);
      card.querySelector<HTMLAnchorElement>("[data-preview-form]")!.href = formPageHref("preview", record.slug);
      card.querySelector<HTMLButtonElement>("[data-delete-form]")!.addEventListener("click", async () => {
        if (!window.confirm(`${tDelete("deleteFormConfirm")}\n\n${localizedName(record)}`)) return;
        const result = await formRepository.deleteNamedForm(record.id);
        if (!result.ok) { setStorageState("error"); return; }
        forms = forms.filter(form => form.id !== record.id);
        if (draft?.linkedFormId === record.id) draft = null;
        applyLocale(); renderDraft(); renderForms(); setStorageState("ready");
      });
      list.append(fragment);
    }
    setHidden("[data-forms-no-results]", forms.length === 0 || visibleForms.length > 0);
    setHidden("[data-form-list]", forms.length === 0 || visibleForms.length === 0);
    applyLocale();
  }
  function setStorageState(state: "loading" | "ready" | "error") {
    setHidden("[data-forms-loading]", state !== "loading");
    setHidden("[data-forms-error]", state !== "error");
    setHidden("[data-forms-empty]", state !== "ready" || forms.length !== 0);
    setHidden("[data-search-control]", state !== "ready" || forms.length < 2);
    if (state !== "ready") { setHidden("[data-form-list]", true); setHidden("[data-forms-no-results]", true); }
  }
  searchInput?.addEventListener("input", () => { query = searchInput.value; renderForms(); });
  landing?.querySelectorAll<HTMLButtonElement>("[data-code-tab]").forEach(button => button.addEventListener("click", () => { const selected = button.dataset.codeTab; landing.querySelectorAll<HTMLButtonElement>("[data-code-tab]").forEach(tab => tab.setAttribute("aria-selected", String(tab === button))); landing.querySelectorAll<HTMLElement>("[data-code-panel]").forEach(panel => { panel.hidden = panel.dataset.codePanel !== selected; }); }));
  landing?.querySelector<HTMLButtonElement>("[data-copy-code]")?.addEventListener("click", async event => { const button = event.currentTarget; const code = landing.querySelector<HTMLElement>("[data-code-panel]:not([hidden]) code")?.textContent ?? ""; try { await navigator.clipboard.writeText(code); button.textContent = t("copied"); window.setTimeout(() => { button.textContent = t("copy"); }, 1600); } catch { button.textContent = t("copyFailed"); } });
  formI18n.on("languageChanged", () => {
    applyLocale(); renderDraft(); renderForms();
  });
  applyLocale();
  setStorageState("loading");
  void Promise.all([formRepository.listNamedForms(), formRepository.getCurrentDraft()]).then(([formsResult, draftResult]) => {
    if (!formsResult.ok || !draftResult.ok) { setStorageState("error"); return; }
    forms = formsResult.value;
    draft = draftResult.value;
    applyLocale(); renderDraft(); renderForms(); setStorageState("ready");
  });
</script>
