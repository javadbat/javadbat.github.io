---
interface Props {
  title?: string;
  description?: string;
  lang?: string;
  dir?: "ltr" | "rtl";
}

const { title = "mohammad javad bathaei", description = "seyed mohammad javad bathaei official website", lang = "en", dir = "ltr" } = Astro.props;
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<meta charset="UTF-8" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.svg" />
		<link rel="stylesheet" href="/styles/globals.css" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
