{
  "name": "jb-form-builder",
  "version": "0.1.0",
  "description": "Portable JSON-to-JB-form renderer web component",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./define": { "types": "./dist/define.d.ts", "default": "./dist/define.js" },
    "./react": { "types": "./dist/react/index.d.ts", "default": "./dist/react.js" },
    "./dependency-loader": { "types": "./dist/dependency-loader.d.ts", "default": "./dist/dependency-loader.js" },
    "./types": { "types": "./dist/types.d.ts", "default": "./dist/types.js" },
    "./contract": { "types": "./dist/contract/index.d.ts", "default": "./dist/contract.js" },
    "./contract/validation": { "types": "./dist/contract/form-document-validation.d.ts", "default": "./dist/form-document-validation.js" },
    "./contract/theme": { "types": "./dist/contract/theme-config.d.ts", "default": "./dist/theme-config.js" },
    "./registry/form-element-adapter": { "types": "./dist/registry/form-element-adapter.d.ts", "default": "./dist/form-element-adapter.js" },
    "./registry/form-element-configuration": { "types": "./dist/registry/form-element-configuration.d.ts", "default": "./dist/form-element-configuration.js" },
    "./registry/form-element-registry": { "types": "./dist/registry/form-element-registry.d.ts", "default": "./dist/form-element-registry.js" },
    "./registry/validation-rule-registry": { "types": "./dist/registry/validation-rule-registry.d.ts", "default": "./dist/validation-rule-registry.js" }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest run src",
    "prepare": "npm run build"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "jb-button": "^4.1.0",
    "jb-checkbox": "^2.0.0",
    "jb-condition": "file:../jb-condition",
    "jb-core": "^0.34.0",
    "jb-date-input": "^6.5.0",
    "jb-file-input": "^3.3.0",
    "jb-form": "^0.12.0",
    "jb-form-wizard": "file:../jb-form-wizard",
    "jb-image-input": "^3.10.1",
    "jb-input": "^3.18.0",
    "jb-mobile-input": "^2.4.0",
    "jb-national-input": "^2.4.2",
    "jb-number-input": "^1.6.0",
    "jb-password-input": "^2.2.0",
    "jb-payment-input": "^3.5.0",
    "jb-pin-input": "^1.15.0",
    "jb-range-input": "^0.4.0",
    "jb-select": "^8.1.0",
    "jb-switch": "^1.7.3",
    "jb-tab": "^0.1.0",
    "jb-textarea": "^3.13.2",
    "jb-time-input": "^2.4.0",
    "jb-validation": "^1.0.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "happy-dom": "^20.11.1",
    "react": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^7.1.6",
    "vitest": "^4.1.10"
  }
}
